# PAPER ONLY
PAPER_ONLY=true

# Kraken credentials belong only on the Ubuntu application host.
# Configure READ-ONLY query permissions only.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Remote private Nemotron inference endpoint.
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://PRIVATE_VPS_HOST:PORT/v1
AI_MODEL=nemotron-3-nano
AI_API_KEY=
AI_TIMEOUT_SECONDS=120

# Persistence
DATABASE_URL=sqlite:///data/krakenfondazione.db

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501
