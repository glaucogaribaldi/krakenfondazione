# PAPER ONLY
PAPER_ONLY=true

# Kraken credentials belong only on the Ubuntu application host.
# Configure READ-ONLY query permissions only.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Verified private Nemotron inference endpoint (Tailscale).
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://100.73.54.72:8080/v1
# During install, query /v1/models and set the ACTUAL returned model ID here.
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=120

# Persistence
DATABASE_URL=sqlite:///data/krakenfondazione.db

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501
