# Kraken Fondazione — paper-only configuration
PAPER_ONLY=true

# Kraken read-only credentials. Never commit real values.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Local AI
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# Persistence
DATABASE_URL=sqlite:///data/krakenfondazione.db

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501
